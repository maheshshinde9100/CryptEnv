<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.maheshshinde9100</groupId>
    <artifactId>cryptenv-sdk</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>

    <name>CryptEnv Java SDK</name>

    <description>
        Java SDK for CryptEnv secure secret management platform.
        Provides type-safe access to CryptEnv workspaces, environments, and secrets
        through JWT authentication, with AES-256-GCM client-side decryption support.
    </description>

    <url>https://github.com/maheshshinde9100/CryptEnv</url>

    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
            <comments>OSI-approved open source license</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>maheshshinde9100</id>
            <name>Mahesh Shinde</name>
            <email>maheshshinde9100@gmail.com</email>
            <url>https://github.com/maheshshinde9100</url>
            <roles>
                <role>author</role>
                <role>maintainer</role>
            </roles>
            <timezone>Asia/Kolkata</timezone>
        </developer>
    </developers>

    <contributors>
        <contributor>
            <name>Mahesh Shinde</name>
            <url>https://github.com/maheshshinde9100</url>
        </contributor>
    </contributors>

    <scm>
        <connection>scm:git:https://github.com/maheshshinde9100/CryptEnv.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:maheshshinde9100/CryptEnv.git</developerConnection>
        <url>https://github.com/maheshshinde9100/CryptEnv</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/maheshshinde9100/CryptEnv/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/maheshshinde9100/CryptEnv/actions</url>
    </ciManagement>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jackson.version>2.16.1</jackson.version>

        <gpg.skip>true</gpg.skip>
        <maven.javadoc.skip>false</maven.javadoc.skip>
        <maven.source.skip>false</maven.source.skip>
        <skipTests>false</skipTests>

        <maven.clean.failOnError>false</maven.clean.failOnError>
        <maven.clean.verbose>false</maven.clean.verbose>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <failOnError>${maven.clean.failOnError}</failOnError>
                    <verbose>${maven.clean.verbose}</verbose>
                    <filesets>
                        <fileset>
                            <directory>${project.build.directory}</directory>
                            <includes>
                                <include>**/*.asc</include>
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <parameters>true</parameters>
                    <debug>true</debug>
                    <optimize>true</optimize>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <skipTests>${skipTests}</skipTests>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <skipSource>${maven.source.skip}</skipSource>
                    <attach>true</attach>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <doclint>none</doclint>
                    <encoding>UTF-8</encoding>
                    <charset>UTF-8</charset>
                    <locale>en_US</locale>
                    <source>17</source>
                    <notimestamp>true</notimestamp>
                    <quiet>true</quiet>
                    <failOnError>false</failOnError>
                    <skip>${maven.javadoc.skip}</skip>
                    <additionalOptions>
                        <additionalOption>-Xdoclint:none</additionalOption>
                    </additionalOptions>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <packageName>com.maheshshinde.cryptenv.sdk</packageName>
                        </manifest>
                        <manifestEntries>
                            <Specification-Title>CryptEnv Java SDK</Specification-Title>
                            <Specification-Version>${project.version}</Specification-Version>
                            <Specification-Vendor>Mahesh Shinde</Specification-Vendor>
                            <Implementation-Title>CryptEnv Java SDK</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-Vendor>Mahesh Shinde</Implementation-Vendor>
                            <Implementation-URL>https://github.com/maheshshinde9100/CryptEnv</Implementation-URL>
                            <Created-By>Apache Maven</Created-By>
                            <Build-Jdk-Spec>${maven.compiler.source}</Build-Jdk-Spec>
                            <License>MIT</License>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.7</version>

<configuration>
    <skip>${gpg.skip}</skip>
    <gpgArguments>
        <arg>--pinentry-mode</arg>
        <arg>loopback</arg>
        <arg>--yes</arg>
    </gpgArguments>
</configuration>

                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <tokenAuth>true</tokenAuth>
                    <autoPublish>false</autoPublish>
                    <wait>false</wait>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>local</id>
            <properties>
                <gpg.skip>true</gpg.skip>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <maven.source.skip>false</maven.source.skip>
                <maven.clean.failOnError>false</maven.clean.failOnError>
            </properties>
        </profile>

        <profile>
            <id>publish</id>
            <activation>
                <property>
                    <name>env.MAVEN_CENTRAL_TOKEN</name>
                </property>
            </activation>
            <properties>
                <gpg.skip>${CRYPTENV_GPG_SKIP}</gpg.skip>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <maven.source.skip>false</maven.source.skip>
                <maven.clean.failOnError>false</maven.clean.failOnError>
            </properties>
        </profile>

        <profile>
            <id>ossrh</id>
            <distributionManagement>
                <snapshotRepository>
                    <id>ossrh</id>
                    <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
                </snapshotRepository>
                <repository>
                    <id>ossrh</id>
                    <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2</url>
                </repository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.plugins</groupId>
                        <artifactId>nexus-staging-maven-plugin</artifactId>
                        <version>1.6.13</version>
                        <extensions>true</extensions>
                        <configuration>
                            <serverId>ossrh</serverId>
                            <nexusUrl>https://s01.oss.sonatype.org/</nexusUrl>
                            <autoReleaseAfterClose>true</autoReleaseAfterClose>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <gpg.skip>${env.CRYPTENV_SKIP_GPG:-false}</gpg.skip>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <maven.source.skip>false</maven.source.skip>
                <maven.clean.failOnError>false</maven.clean.failOnError>
            </properties>
        </profile>
    </profiles>

</project>