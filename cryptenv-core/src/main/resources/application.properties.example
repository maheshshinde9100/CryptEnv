# ============================================================
# CryptEnv Core - Application Configuration TEMPLATE
# ============================================================
# SECURITY RULES (READ THIS BEFORE DEPLOYING):
#
# 1. COPY this file to application.properties for LOCAL development ONLY.
# 2. This file is SAFE to commit. NEVER put real secrets here.
# 3. ALL credentials come from OS / Render env vars (see .env.production template keys).
# 4. Required keys (must match Render Environment / .env.production):
#      DB_URL, DB_USER, DB_PASS, JWT_SECRET, MASTER_ENCRYPTION_KEY
#    Optional:
#      PORT, JWT_EXPIRATION, CORS_ALLOWED_ORIGINS, SPRINGDOC_ENABLED, CRYPTENV_FLYWAY_ENABLED
# 5. Local: load .env.production into your shell before `mvn spring-boot:run`.
# 6. Render: set the same keys in Dashboard → Environment (do not commit them).
# ============================================================

# -------- Server --------
server.port=${PORT:8080}
server.address=0.0.0.0
server.shutdown=graceful

# -------- Application Name & Startup --------
spring.application.name=cryptenv-core
spring.main.banner-mode=off

# -------- Fast Cold-Start (GraalVM JIT on Render 512MB) --------
# JVM system properties applied in Dockerfile JAVA_OPTS:
#   -Dspring.beaninfo.ignore=true   (skip java.beans.BeanInfo classpath scan, ~1s saved)
#   -Djava.awt.headless=true        (no AWT toolkit)
#   TieredStopAtLevel=1 + SerialGC  (fast warmup, low heap overhead)
# All of these are already applied in cryptenv-core/Dockerfile.

# -------- CORS (comma-separated dashboard URLs) --------
cryptenv.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:3000}

# -------- PostgreSQL Database --------
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASS}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.leak-detection-threshold=20000
spring.datasource.hikari.auto-commit=false
spring.datasource.hikari.transaction-isolation=TRANSACTION_READ_COMMITTED

# -------- JPA / Hibernate --------
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jpa.properties.hibernate.jdbc.batch_size=50
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true
spring.jpa.properties.hibernate.query.in_clause_parameter_padding=true

# -------- Flyway --------
# Auto-config off; custom FlywayConfig uses cryptenv.flyway.enabled
spring.flyway.enabled=false
cryptenv.flyway.enabled=${CRYPTENV_FLYWAY_ENABLED:true}
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=false
spring.flyway.out-of-order=false

# -------- Security & JWT --------
# Generate: openssl rand -hex 32
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION:86400000}

# -------- Rate limiting (per client IP) --------
cryptenv.rate-limit.enabled=${RATE_LIMIT_ENABLED:true}
cryptenv.rate-limit.capacity=${RATE_LIMIT_CAPACITY:120}
cryptenv.rate-limit.refill-per-minute=${RATE_LIMIT_REFILL:120}
cryptenv.rate-limit.auth-capacity=${RATE_LIMIT_AUTH_CAPACITY:30}
cryptenv.rate-limit.auth-refill-per-minute=${RATE_LIMIT_AUTH_REFILL:30}

# -------- Master encryption key (wraps workspace keys only) --------
# Generate: openssl rand -base64 32
cryptenv.master-key=${MASTER_ENCRYPTION_KEY}
encryption.master.key=${MASTER_ENCRYPTION_KEY}

# -------- Swagger / OpenAPI --------
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.enabled=${SPRINGDOC_ENABLED:false}

# -------- Logging --------
logging.level.com.maheshshinde.CryptEnv=INFO
logging.level.org.springframework.security=WARN
logging.level.org.hibernate.SQL=WARN
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=WARN
logging.level.org.flywaydb.core.internal.command.DbMigrate=INFO
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
