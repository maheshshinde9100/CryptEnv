<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Levels come from Spring's logging.level.* properties so an environment variable
         (LOGGING_LEVEL_COM_MAHESHSHINDE_CRYPTENV=DEBUG) can raise detail without a redeploy.
         Defaults are production-safe: DEBUG/TRACE logging balloons startup memory on small hosts. -->
    <springProperty scope="context" name="APP_LOG_LEVEL"
                    source="logging.level.com.maheshshinde.CryptEnv" defaultValue="INFO"/>
    <springProperty scope="context" name="SECURITY_LOG_LEVEL"
                    source="logging.level.org.springframework.security" defaultValue="WARN"/>
    <springProperty scope="context" name="SQL_LOG_LEVEL"
                    source="logging.level.org.hibernate.SQL" defaultValue="WARN"/>
    <springProperty scope="context" name="BINDER_LOG_LEVEL"
                    source="logging.level.org.hibernate.type.descriptor.sql.BasicBinder" defaultValue="WARN"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <logger>logger</logger>
                <message>message</message>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <springProfile name="json-logging">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!json-logging">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <logger name="com.maheshshinde.CryptEnv" level="${APP_LOG_LEVEL}"/>
    <logger name="org.springframework.security" level="${SECURITY_LOG_LEVEL}"/>
    <logger name="org.hibernate.SQL" level="${SQL_LOG_LEVEL}"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="${BINDER_LOG_LEVEL}"/>
</configuration>
