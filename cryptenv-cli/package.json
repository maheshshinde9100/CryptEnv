{
  "name": "cryptenv-cli",
  "version": "1.3.0",
  "description": "CryptEnv CLI — runtime secret injection for the CryptEnv Spring Boot API. Workspaces, secrets, and cryptenv run. Default: https://cryptenv-backend.onrender.com/api",
  "main": "index.js",
  "bin": {
    "cryptenv": "bin/cryptenv.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cryptenv.js",
    "pack": "npm pack",
    "test": "node -e \"require('./bin/cryptenv.js');\""
  },
  "keywords": [
    "cli",
    "cryptenv",
    "secrets",
    "env",
    "environment",
    "security",
    "vault"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maheshshinde9100/CryptEnv.git"
  },
  "author": "Mahesh Shinde",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "inquirer": "^8.2.5",
    "keytar": "^7.9.0",
    "ora": "^5.4.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
