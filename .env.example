PORT=8080
DB_URL=
DB_USER=
DB_PASS=

# openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-characters
# openssl rand -base64 32
MASTER_ENCRYPTION_KEY=replace-with-base64-of-32-bytes

# ---------- SMTP (verification + notification email) ----------
# REQUIRED for sign-up verification emails. Without a host the app boots,
# but new accounts cannot receive a code.
# Local dev (docker compose mailhog): host=localhost, port=1025, no auth.
# Brevo relay: host=smtp-relay.brevo.com, username=<SMTP login>,
#   password=<SMTP key starting with xsmtpsib->, port 587 or 2525 with STARTTLS.
#   Use 2525 on hosts that block 587 (Render does).
# This file is a template only. The backend loads cryptenv-core/.env.production
# at startup for any variable that is not already set in the real environment,
# so filling that file is enough for local runs.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
CRYPTENV_NOTIFICATIONS_FROM=no-reply@cryptenv.local
CRYPTENV_NOTIFICATIONS_FROM_NAME=CryptEnv
# If the host blocks outbound SMTP ports (common on free PaaS), use an HTTPS API instead.
# CRYPTENV_MAIL_PROVIDER=brevo        # smtp | brevo | resend | none
# BREVO_API_KEY=
# RESEND_API_KEY=

# ---------- Google OAuth2 login ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback
# CRYPTENV_DASHBOARD_URL=http://localhost:3000
# Additional dashboard origins allowed to receive the OAuth redirect (comma-separated)
# CRYPTENV_OAUTH_ALLOWED_ORIGINS=

# ---------- Optional ----------
# Reject sign-up addresses with no MX records (typos like gmial.com are also suggested).
# Set false only if your network blocks DNS lookups.
# CRYPTENV_EMAIL_DNS_CHECK=true
# JWT_EXPIRATION=86400000
# JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
SPRINGDOC_ENABLED=false
CRYPTENV_FLYWAY_ENABLED=true
# CRYPTENV_APPROVALS_ENABLED=true
# CRYPTENV_APPROVALS_TTL_HOURS=24
# CRYPTENV_WEBHOOKS_ENABLED=true
# CRYPTENV_NOTIFICATIONS_ENABLED=true
# CRYPTENV_ENVELOPE_ENCRYPTION_ENABLED=false
# CRYPTENV_DRIFT_STALE_DAYS=30
